@startuml
title Course Timetabling — Class Search subsystem\n(<<new>> marks SearchResultCounter additions)

scale 0.8

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #3D405B
skinparam ClassBorderColor #3D405B
skinparam ClassBackgroundColor #F7F7F2
skinparam InterfaceBackgroundColor #EAF4F4
skinparam nodesep 25
skinparam ranksep 30

' Row 1: action layer
together {
  abstract class UniTimeAction<T> {
    #sessionContext : SessionContext
    #request : HttpServletRequest
    #form : T
  }
  class ClassSearchAction <<@Action>> {
    -{static} MSG : CourseMessages
    +execute() : String
    +performAction(action) : String
    +{static} getClasses(form, proxy) : Set
    .. <<new>> SearchResultCounter ..
    setAttribute("resultCount", size)
  }
}

' Row 1: form layer
together {
  interface ClassListFormInterface {
    +getSubjectAreaIds() : String[]
    +getCourseNbr() : String
    +getFilterInstructor() : String
  }
  class ClassListForm {
    -subjectAreaIds : String[]
    -courseNbr : String
    +validate(action) : void
  }
}

' Supporting interfaces
interface CourseMessages {
  +actionSearchClasses() : String
  +errorNoRecords() : String
  .. <<new>> ..
  +foundClasses() : String
}

interface SessionContext {
  +checkPermission(right) : void
  +hasPermission(right) : boolean
}

class WebClassListTableBuilder {
  +htmlTableForClasses(...) : void
}

' Domain model chain — names only
class Department <<@Entity>>
class SubjectArea <<@Entity>>
class CourseOffering <<@Entity>>
class InstructionalOffering <<@Entity>>
class SchedulingSubpart <<@Entity>>
class Class_ <<@Entity>>

hide Department members
hide SubjectArea members
hide CourseOffering members
hide InstructionalOffering members
hide SchedulingSubpart members
hide Class_ members

' Relationships
UniTimeAction <|-- ClassSearchAction
ClassListFormInterface <|.. ClassListForm

ClassSearchAction --> ClassListForm         : form
ClassSearchAction ..> CourseMessages        : MSG
ClassSearchAction ..> SessionContext        : context
ClassSearchAction ..> WebClassListTableBuilder : printTable()
ClassSearchAction ..> Class_               : result
ClassSearchAction ..> CourseOffering       : result

Department --> SubjectArea
SubjectArea --> CourseOffering
CourseOffering --> InstructionalOffering
InstructionalOffering --> SchedulingSubpart
SchedulingSubpart --> Class_

@enduml
