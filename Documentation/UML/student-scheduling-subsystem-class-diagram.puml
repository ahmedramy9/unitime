@startuml
title Student Scheduling / Online Sectioning subsystem class diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #3D405B
skinparam ClassBorderColor #3D405B
skinparam ClassBackgroundColor #F7F7F2
skinparam InterfaceBackgroundColor #EAF4F4

package "GWT service layer" {
  interface SectioningService
  class SectioningServlet <<Spring @Service>> {
    +checkEligibility(...)
    +listCourseOfferings(...)
    +getCourseRequest(...)
    +getClassAssignment(...)
  }
  class GwtRpcServlet {
    +execute(GwtRpcRequest)
    +getImplementation(request)
  }
  interface GwtRpcImplementation
  class SectioningReportsBackend <<@GwtRpcImplements>> {
    +execute(SectioningReportRpcRequest, SessionContext)
  }
}

package "Online sectioning core" {
  interface OnlineSectioningServer {
    +findCourses(...)
    +getStudent(...)
    +getOffering(...)
    +execute(OnlineSectioningAction, user)
    +assign(request, enrollment)
    +waitlist(request, flag)
  }
  interface OnlineSectioningAction<T> {
    +execute(server, helper)
    +name()
  }
  class CheckCourses
  class GetAssignment
  class ListCourseOfferings
  class GenerateSectioningReport
  class XStudent
  class XOffering
  class XCourseRequest
  class XEnrollment
}

package "Solver services" {
  class SolverServerService
  class SolverService<T>
  class StudentSolverProxy {
    +getReport(parameters)
  }
}

package "Persistent scheduling model" {
  class Student {
    +uniqueId
    +externalUniqueId
    +courseDemands
    +classEnrollments
  }
  class CourseDemand {
    +priority
    +waitlist
    +alternative
  }
  class CourseRequest {
    +order
    +allowOverlap
    +credit
  }
  class CourseOffering {
    +courseNbr
    +title
  }
  class InstructionalOffering {
    +notOffered
    +byReservationOnly
    +waitlistMode
  }
  class InstrOfferingConfig {
    +limit
    +unlimitedEnrollment
  }
  class SchedulingSubpart {
    +minutesPerWk
    +studentAllowOverlap
  }
  class Class_ {
    +expectedCapacity
    +enabledForStudentScheduling
  }
  class StudentClassEnrollment {
    +timestamp
    +approvedDate
  }
  abstract class Reservation {
    +limit
    +startDate
    +expirationDate
  }
  class IndividualReservation
  class StudentGroupReservation
  class CurriculumReservation
  class CourseReservation
}

package "Infrastructure" {
  class SessionContext
  class StudentDAO
  class CourseDemandDAO
  class CourseOfferingDAO
  class SessionDAO
}

SectioningService <|.. SectioningServlet
GwtRpcImplementation <|.. SectioningReportsBackend
GwtRpcServlet --> GwtRpcImplementation : looks up Spring bean by request class
SectioningReportsBackend --> SolverServerService : online solver container
SectioningReportsBackend --> SolverService : batch solver service
SolverService --> StudentSolverProxy
SolverServerService --> OnlineSectioningServer

SectioningServlet --> OnlineSectioningServer : executes student actions
SectioningServlet --> StudentDAO
SectioningServlet --> CourseDemandDAO
SectioningServlet --> CourseOfferingDAO
SectioningServlet --> SessionContext : permissions/user
SectioningReportsBackend --> SessionContext : permissions/user
SectioningReportsBackend --> SessionDAO

OnlineSectioningServer --> OnlineSectioningAction : createAction/execute
OnlineSectioningAction <|.. CheckCourses
OnlineSectioningAction <|.. GetAssignment
OnlineSectioningAction <|.. ListCourseOfferings
OnlineSectioningAction <|.. GenerateSectioningReport
OnlineSectioningServer --> XStudent
OnlineSectioningServer --> XOffering
OnlineSectioningServer --> XCourseRequest
OnlineSectioningServer --> XEnrollment

Student "1" --> "0..*" CourseDemand : courseDemands
CourseDemand "1" --> "0..*" CourseRequest : courseRequests
CourseRequest "0..*" --> "1" CourseOffering : courseOffering
CourseOffering "0..*" --> "1" InstructionalOffering : instructionalOffering
InstructionalOffering "1" --> "0..*" InstrOfferingConfig : configs
InstrOfferingConfig "1" --> "0..*" SchedulingSubpart : subparts
SchedulingSubpart "1" --> "0..*" Class_ : classes
Student "1" --> "0..*" StudentClassEnrollment : classEnrollments
StudentClassEnrollment "0..*" --> "1" Class_ : clazz
StudentClassEnrollment "0..*" --> "0..1" CourseRequest : courseRequest
InstructionalOffering "1" --> "0..*" Reservation : reservations
Reservation <|-- IndividualReservation
Reservation <|-- StudentGroupReservation
Reservation <|-- CurriculumReservation
Reservation <|-- CourseReservation

note bottom
Relationships are reverse-engineered from SectioningServlet imports,
GwtRpcServlet/SectioningReportsBackend execution flow, Hibernate mappings,
and generated base model annotations.
end note

@enduml
